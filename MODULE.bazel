module(
    name = "sheaf",
    version = "2.3.0",
)

bazel_dep(name = "apple_support", version = "1.24.2")
bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "libbacktrace", version = "1.0.0-20250926-7939218")
bazel_dep(name = "llvm", version = "0.8.9")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.19")
bazel_dep(name = "rules_python", version = "1.9.0")
bazel_dep(name = "rules_rust", version = "0.73.0")
bazel_dep(name = "rules_shell", version = "0.6.1")

register_toolchains(
    "@llvm//toolchain:linux_aarch64_to_linux_aarch64",
    "@llvm//toolchain:linux_x86_64_to_linux_x86_64",
)

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    versions = ["1.95.0"],
)
use_repo(rust, "rust_toolchains")
register_toolchains("@rust_toolchains//:all")

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//sheaf:Cargo.lock",
    lockfile = "//:cargo-bazel-lock.json",
    manifests = ["//sheaf:Cargo.toml"],
    supported_platform_triples = [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "x86_64-unknown-linux-gnu",
    ],
)
use_repo(crate, "crates")

iree_source_repository = use_repo_rule(
    "//bazel:iree_source_repository.bzl",
    "iree_source_repository",
)
iree_source_repository(
    name = "iree",
    cargo_toml = "//sheaf:Cargo.toml",
)

iree_cuda_repository = use_repo_rule(
    "//bazel:iree_cuda_repository.bzl",
    "iree_cuda_repository",
)
iree_cuda_repository(name = "iree_cuda")

iree_compiler_repository = use_repo_rule(
    "//bazel:iree_compiler_repository.bzl",
    "iree_compiler_repository",
)
iree_compiler_repository(
    name = "iree_compiler",
    cargo_toml = "//sheaf:Cargo.toml",
)

http_file = use_repo_rule(
    "@bazel_tools//tools/build_defs/repo:http.bzl",
    "http_file",
)
http_file(
    name = "nanogpt_weights",
    downloaded_file_path = "model.safetensors",
    sha256 = "4d01102ce7c7d7a41e76ee785211bd35f6734dd7d4a9e3eecd85f1a23308a239",
    urls = [
        "https://huggingface.co/dbrll/sheaf-nanogpt-shakespeare/resolve/a4cda36d4659b50af7775dcfabc430f72b37e28d/model.safetensors",
    ],
)

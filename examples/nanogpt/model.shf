;; -*- mode: clojure -*-

;; Lower-triangular causal attention mask
(defn causal-mask [T]
  (== (tril (ones [T T])) 1.0))

;; Use -1e10 rather than literal -inf to avoid NaN
(def neg-inf -1e10)


(defn layer-norm-nb [x gamma]
  (let [m (mean x :axis -1 :keepdims)
        v (var  x :axis -1 :keepdims)]
    (* (/ (- x m) (sqrt (+ v 1e-5))) gamma)))


(defn init-block [key D]
  ;; One transformer block with GPT-2 init
  (let [[k-attn k-proj k-fc k-fc2] (random-split key 4)
        D3 (* 3 D)
        D4 (* 4 D)]
    {:attn {:c_attn  {:weight (* (random-normal k-attn [D3 D]) 0.02)}
            :c_proj  {:weight (* (random-normal k-proj [D D])  0.02)}}
     :mlp  {:c_fc    {:weight (* (random-normal k-fc   [D4 D]) 0.02)}
            :c_proj  {:weight (* (random-normal k-fc2  [D D4]) 0.02)}}
     :ln_1 {:weight (ones [D])}
     :ln_2 {:weight (ones [D])}}))


(defn init-gpt-params [key config]
  ;; Build the HuggingFace parameters layout expected by gpt-forward.
  (let [V (get config :vocab_size)
        D (get config :n_embd)
        B (get config :block_size)
        L (get config :n_layer)
        [k-wte k-wpe k-blocks k-head] (random-split key 4)
        block-keys (random-split k-blocks L)]
    {:transformer
      {:wte  {:weight (* (random-normal k-wte [V D]) 0.02)}
       :wpe  {:weight (* (random-normal k-wpe [B D]) 0.02)}
       :h    (map (fn [bk] (init-block bk D)) block-keys)
       :ln_f {:weight (ones [D])}}
     :lm_head {:weight (* (random-normal k-head [V D]) 0.02)}}))


(defn causal-self-attention [x attn-p config]
  (let [D  (get config :n_embd)
        H  (get config :n_head)
        Hd (// D H)
        T  (get (shape x) -2)]

    (as-> x h
      (with-params [attn-p :c_attn]
        (let 
              ;; Split fused QKV weight [3D, D] into three [D, D] matrices
             [Wq (slice weight 0 D)
              Wk (slice weight D (* 2 D))
              Wv (slice weight (* 2 D) (* 3 D))

              ;; Project then split into attention heads
              q  (swapaxes (reshape (@ h (tr Wq)) [-1 T H Hd]) 1 2)
              k  (swapaxes (reshape (@ h (tr Wk)) [-1 T H Hd]) 1 2)
              v  (swapaxes (reshape (@ h (tr Wv)) [-1 T H Hd]) 1 2)

              ;; Scaled dot-product scores, then causal mask + softmax
              scores (/ (@ q (swapaxes k -1 -2)) (sqrt Hd))
              att    (softmax (where (causal-mask T) scores neg-inf)
                              :axis -1)]
          ;; Reassemble heads: [B, H, T, Hd] -> [B, T, D]
          (reshape (swapaxes (@ att v) 1 2) [-1 T D])))
      (with-params [attn-p :c_proj]
        (@ h (tr weight))))))                   ; output projection


(defn mlp-block [x mlp-p]
  (as-> x h
    (with-params [mlp-p :c_fc]
      (gelu (@ h (tr weight))))
    (with-params [mlp-p :c_proj]
      (@ h (tr weight)))))


(defn transformer-block [x block-p config]
  (as-> x h
    (+ h (causal-self-attention
            (with-params [block-p :ln_1] (layer-norm-nb h weight))
            (get block-p :attn) config))
    (+ h (mlp-block
            (with-params [block-p :ln_2] (layer-norm-nb h weight))
            (get block-p :mlp)))))


(defn gpt-forward [idx params config]
  (let [T  (get (shape idx) -1)
        D  (get config :n_embd)

        ;; Embedding tables, block stack, final norm and LM head
        wte    (get-in params [:transformer :wte :weight])
        wpe    (get-in params [:transformer :wpe :weight])
        blocks (get-in params [:transformer :h])
        ln-f   (get-in params [:transformer :ln_f :weight])
        head   (get-in params [:lm_head :weight])

        ;; Token + position embeddings
        x  (+ (get wte idx)
              (reshape (slice wpe 0 T) [1 T D]))

        ;; Transformer blocks
        x  (reduce (fn [h bp] (transformer-block h bp config)) x blocks)

        ;; Final LayerNorm
        x  (layer-norm-nb x ln-f)]
    (@ x (tr head))))


(defn generate-token [ids params config key top-k temp]
  ;; Top-k sampling with temperature
  (let [logits     (gpt-forward ids params config)
        V          (get config :vocab_size)
        last-logit (/ (last (reshape logits [-1 V])) temp)
        [top-vals top-idx] (top_k last-logit (minimum top-k V))
        probs      (softmax top-vals :axis -1)
        [new-key subkey] (random-split key)
        next-id    (get top-idx (choice subkey (len probs) :p probs))]
    {:next_id next-id :key new-key}))

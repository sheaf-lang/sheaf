;; -*- mode: clojure -*-
;; XOR MLP — pure functions (no side effects): forward pass and training step

(use nn)
(use optim)

(defparams MLPParams {:l1 {:W [2 8] :b [8]}
                      :l2 {:W [8 1] :b [1]}})

(defn forward [(x [4 2]) (p :as MLPParams)]
  (as-> x h
    (with-params [p :l1] (relu (+ (@ h W) b)))
    (with-params [p :l2] (sigmoid (+ (@ h W) b)))))

(defn train-step [(p :as MLPParams) (x [4 2]) (y [4 1]) lr]
  (let [loss-fn (fn [p] (mean (** (- (forward x p) y) 2)))
        [l g] ((value-and-grad loss-fn) p)]
    {:p (sgd-step p g lr) :loss l}))

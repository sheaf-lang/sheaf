;; -*- mode: clojure -*-

;; A reference implementation of a generative Transformer in Sheaf.
;; Ported from BareGPT (https://github.com/dbrll/BareGPT)

(use nn)


(defn init-gpt-params [key config]
  (let [;; Global config and keys
        D (get config :d_model)
        B (get config :block_size)
        V (get config :vocab_size)
        L (get config :n_layers)
        keys (random-split key 4)
        k_emb (nth keys 0)
        k_layers (nth keys 1)
        k_head (nth keys 2)
        k_ln (nth keys 3)

        ;; Sub-dictionaries preparation
        k_emb_split (random-split k_emb 2)
        emb-tensors  {:token (* (random-normal (nth k_emb_split 0) [V D]) 0.01)
                      :pos   (* (random-normal (nth k_emb_split 1) [B D]) 0.01)}

        head-tensors {:w (* (xavier-init k_head [D V]))
                      :b (zeros [V])}]

    ;; Final params structure
    {
      :emb      emb-tensors
      :head     head-tensors
      :final_ln {:gamma (ones [1 D])
                 :beta  (zeros [1 D])}
      :layers   (map  (fn [i] ;; Init lambda
                       (let [k (nth (random-split k_layers L) i)
                             k_attn (random-split k 4)
                             k_mlp  (random-split k 2)]

                         {:attn {:Wq (xavier-init (nth k_attn 0) [D D])
                                 :Wk (xavier-init (nth k_attn 1) [D D])
                                 :Wv (xavier-init (nth k_attn 2) [D D])
                                 :Wo (xavier-init (nth k_attn 3) [D D])}

                          :mlp  {:W1 (xavier-init (nth k_mlp 0) [D (* 4 D)])
                                 :b1 (zeros [1 (* 4 D)])
                                 :W2 (xavier-init (nth k_mlp 1) [(* 4 D) D])
                                 :b2 (zeros [1 D])}

                          :ln1 { :gamma (ones [1 D]) :beta (zeros [1 D])}
                          :ln2 { :gamma (ones [1 D]) :beta (zeros [1 D])}}))
                      (range L))})) ;; On each layer


;; Recursively compiles the entire model graph; remove ':jit' for tracing/debugging
(defn gpt-model [inputs params config] :jit
  (let [emb-tensors (get-in params [:emb :token])
        pos-tensors (get-in params [:emb :pos])
        T (get (shape inputs) -1)
        D (static (get config :d_model)) ;; Explicitly get D for reshape

        ;; Token embeddings [Batch, T, D]
        tok_emb (get emb-tensors inputs)

        ;; Position embeddings [T, D] -> [1, T, D]
        ;; We force the shape to ensure correct broadcasting across Batch
        pos_emb (reshape (get pos-tensors (range T)) [1 T D])

        X (+ tok_emb pos_emb)]

    (let [hidden (reduce (fn [h layer-p] (transformer-block h layer-p config))
                         X
                         (get params :layers))]

      ;; Final head
      (let [final-norm (layer-norm hidden (get-in params [:final_ln]) 2)
            W-out (get-in params [:head :w])
            b-out (get-in params [:head :b])]
        (+ (@ final-norm W-out) b-out)))))


(defn multi-head-attention [X layer-p config]
  (let [;; Dimension extraction
        T (get (shape X) -2)
        D (static (get config :d_model))
        H (static (get config :n_heads))
        Hd (static (// D H))

        ;; Weight retrieval
        Wq (get layer-p :attn :Wq)
        Wk (get layer-p :attn :Wk)
        Wv (get layer-p :attn :Wv)
        Wo (get layer-p :attn :Wo)

        ;; Multi-head preparation (reshaping weights)
        Wq_multi (reshape Wq D H Hd)
        Kh_multi (reshape Wk D H Hd)
        Vh_multi (reshape Wv D H Hd)

        ;; Q, K, V Projections [Batch, Heads, T, Hd]
        Qh (einsum "... t d, d h k -> ... h t k" X Wq_multi)
        Kh (einsum "... t d, d h k -> ... h t k" X Kh_multi)
        Vh (einsum "... t d, d h k -> ... h t k" X Vh_multi)

        ;; Attention scores [Batch, Heads, T, T]
        Kh_T (swapaxes Kh -1 -2)
        scores (/ (@ Qh Kh_T) (sqrt Hd))

        ;; Causal masking
        m_base (tril (ones [T T]))
        scores_masked (where (== m_base 1.0)
                             scores
                             -3e4)

        att_probs (softmax scores_masked :axis -1)

        ;; Concatenation and Final Projection
        ;; Merge heads back together before applying Wo projection
        att_out (as-> (@ att_probs Vh) h
                      (swapaxes h -2 -3)    ;; [Batch, T, Heads, Hd]
                      (reshape h (shape X)) ;; [Batch, T, D]
                      (@ h Wo))]

    [att_out att_probs]))


(defn mlp [x p]
  (with-params [p]
    (let [h (gelu (+ (@ x W1) b1))]
      (+ (@ h W2) b2))))


(defn transformer-block [x layer-p config]
  (as-> x h
    ;; 1. Self-Attention
    (-> h
        (layer-norm (get layer-p :ln1) 2)
        (multi-head-attention layer-p config)
        (first) ;; Get the attention output, ignore weights
        (+ h))  ;; Residual 1

    ;; 2. MLP
    (-> h
        (layer-norm (get layer-p :ln2) 2)
        (mlp (get layer-p :mlp))
        (+ h)))) ;; Residual 2



(defn generate-token [ids params config key k temp]
  (let [;; Forward pass
        logits (gpt-model ids params config)
        ;; Process last token
        vocab_size (static (get config :vocab_size))
        p-logits (last (reshape logits -1 vocab_size))
        p-probs (where (!= temp 1.0)
                    (softmax (/ p-logits temp) :axis -1)
                    (softmax p-logits :axis -1))
        ;; Random keys
        [new-key subkey] (random-split key)]

    (let [;; Sampling
          next-id (where (and k (> k 0))
                      (let [[top-p top-idx] (top_k p-probs (minimum k vocab_size))]
                        (get top-idx (choice subkey (len top-p) :p (normalize top-p))))
                      (choice subkey vocab_size :p p-probs))]

      ;; Output
      {:next_id next-id
       :key new-key})))

;; -*- mode: clojure -*-
(use nn)
(use optim)

;; Recursivity by design: "forward" can accept any number of layers
(defn forward [x params] :jit
  (let [layers (get params :layers)
        head   (get params :head)
        n      (count layers)]
    (as-> x h
      ;; Use scan for dynamic computation - avoids recompilation when layer count changes
      ;; Handle empty layers case
      (if (> n 0)
        (first (scan (fn [h_in layer_p]
                       (let [h_out (with-params layer_p
                                     (relu (linear h_in W b)))]
                         h_out)) ;; scan expects same-shaped carry, return h_out as both carry and output
                     h
                     layers))
        h)
      ;; Final projection using the same pattern
      (with-params head
        (linear h W b)))))


;; Evolution logic
;; Takes the current model state and returns a deeper model
;; while preserving existing knowledge.
;;
;; Note: Sheaf supports structural transformation within JIT-compiled functions
(defn grow-hydra [params key config] :jit
  ; Get current model configuration
  (let [D       (get config "d_model")
        head-w  (get (get params "head") "W")
        in_dim  (get (shape head-w) 0)
        keys    (random-split key)
        ; Split random keys so the new layer doesn't have the same init values
        k1      (get keys 0)
        k2      (get keys 1)

        ; Reconstruct the parameter tree with the new layer appended
        new-layer {"W" (random-normal k1 [in_dim D])
                   "b" (zeros [D])}
        new-head  {"W" (random-normal k2 [D 1])
                   "b" (zeros '[1])}]
    ; Return
    {"head"   new-head
     "layers" (append (get params "layers") new-layer)}))


(defn train-step [p x y lr]
  (let [loss-fn (fn [params] (mse-loss y (forward x params)))
        [l g] ((value-and-grad loss-fn) p)]
    {"loss" l
     "p" (sgd-step p g lr)}))


(defn loss [p x y]
  (cross-entropy-loss y (forward x p)))
